model Appointment {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  clientId             String              @db.ObjectId
  client               Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceTypeId        String?             @db.ObjectId
  serviceType          ServiceType?        @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  subscriptionPeriodId String?             @db.ObjectId
  subscriptionPeriod   SubscriptionPeriod? @relation(fields: [subscriptionPeriodId], references: [id], onDelete: SetNull)
  technicianId         String?             @db.ObjectId
  technician           Technician?         @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  startAt              DateTime
  endAt                DateTime
  status               AppointmentStatus   @default(SCHEDULED)
  location             String
  notes                String?
  createdByUserId      String              @db.ObjectId
  createdByUser        User                @relation("CreatedAppointments", fields: [createdByUserId], references: [id], onDelete: Restrict)
  isArchived           Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  visit          Visit?
  calendarEvents CalendarEvent[]

  @@index([clientId])
  @@index([startAt])
  @@index([status])
}
