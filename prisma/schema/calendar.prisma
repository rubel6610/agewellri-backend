model CalendarConnection {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  userId             String           @db.ObjectId
  provider           CalendarProvider
  externalAccountId  String
  externalCalendarId String?
  syncStatus         SyncStatus       @default(PENDING)
  lastSyncedAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  calendarEvents CalendarEvent[]
}

model CalendarEvent {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  connectionId    String             @db.ObjectId
  connection      CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  appointmentId   String             @db.ObjectId
  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  externalEventId String
  syncStatus      SyncStatus         @default(SYNCED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

type TimeWindow {
  start String
  end   String
}

type DaySchedule {
  dayOfWeek   Int
  dayName     String
  isOpen      Boolean      @default(true)
  timeWindows TimeWindow[]
}

model WeeklySchedule {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String        @default("Default Weekly Schedule")
  isDefault    Boolean       @default(true)
  days         DaySchedule[]
  slotDuration Int           @default(60)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ScheduleOverride {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  overrideType    OverrideType   @default(DATE)
  status          OverrideStatus @default(CLOSED)
  startDate       DateTime
  endDate         DateTime
  isRecurring     Boolean        @default(false)
  isActive        Boolean        @default(true)
  timeWindows     TimeWindow[]
  offDayId        String?        @db.ObjectId
  createdByUserId String?        @db.ObjectId
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
  @@index([overrideType])
}

model OffDay {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  isRecurring     Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdByUserId String?   @db.ObjectId
  createdByUser   User?     @relation("CreatedOffDays", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
}

