model AuditLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  actorUserId    String?  @db.ObjectId
  actorUser      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  previousValues Json?
  newValues      Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
  @@index([action])
}
