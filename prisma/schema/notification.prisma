model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([readAt])
}

model BillingNotificationRule {
  id                     String          @id @default(auto()) @map("_id") @db.ObjectId
  billingInterval        BillingInterval @unique
  daysBeforeNotice       Int             @default(14)
  templateSubject        String
  templateBody           String
  isActive               Boolean         @default(true)
  sendToClient           Boolean         @default(true)
  sendToDesignatedContact Boolean        @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model BillingNotificationLog {
  id                   String          @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId       String          @db.ObjectId
  subscriptionPeriodId String?         @db.ObjectId
  notificationType     NotificationType
  recipientEmail       String
  recipientRole        String          @default("CLIENT")
  billingInterval      BillingInterval
  scheduledRenewalDate DateTime
  daysBeforeNotice     Int
  sentAt               DateTime        @default(now())
  status               String          @default("SENT")
  messageId            String?
  errorMessage         String?
  createdAt            DateTime        @default(now())

  @@unique([subscriptionId, notificationType, recipientEmail, scheduledRenewalDate])
  @@index([subscriptionId])
  @@index([sentAt])
}

