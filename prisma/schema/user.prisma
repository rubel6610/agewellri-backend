model User {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  email            String     @unique
  passwordHash     String?
  firstName        String
  lastName         String
  phone            String?
  role             UserRole   @default(CLIENT)
  status           UserStatus @default(ACTIVE)
  permissions      String[]
  resetOtp         String?
  resetOtpExpires  DateTime?
  smsOtpHash       String?
  smsOtpExpires    DateTime?
  smsOtpAttempts   Int        @default(0)
  smsOtpLastSentAt DateTime?
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  client              Client?
  notifications       Notification[]
  auditLogs           AuditLog[]
  createdInvitations  Invitation[]   @relation("CreatedInvitations")
  createdAppointments Appointment[]  @relation("CreatedAppointments")
  familyMemberships   FamilyMember[]
}
