# ==============================================================================
# AgeWellRI Backend - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Do NOT commit actual secrets or production keys to version control.
# ==============================================================================

# Server Configuration
PORT=5173
NODE_ENV=development

# Database Connection (MongoDB with Replica Set support required for Prisma transactions)
# Local MongoDB with replica set:
DATABASE_URL="mongodb://localhost:27017/age-wel-ri?replicaSet=rs0&directConnection=true"
# MongoDB Atlas example:
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/age-wel-ri?retryWrites=true&w=majority"

# Frontend & CORS Configuration
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5173"
# Optional comma-separated origins:
# ADDITIONAL_ALLOWED_ORIGINS="http://localhost:3001,https://app.example.com"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-64-character-secret-key"
JWT_EXPIRES_IN=7d

# Initial Admin Seeding (Used when running `pnpm db:seed`)
ADMIN_EMAIL="admin@agewellri.com"
ADMIN_PASSWORD="ChangeMeImmediately123!"
ADMIN_FIRST_NAME="System"
ADMIN_LAST_NAME="Admin"
ADMIN_PHONE="(401) 555-0199"

# Transactional Email (SMTP / Nodemailer)
SMTP_USER="notifications@agewellri.com"
SMTP_PASS="your-smtp-app-password"
SMTP_PORT=587
SMTP_SECURE=false

# Stripe Payment Gateway Credentials (Fallback / Default)
# Note: In production, credentials can be securely configured and updated directly
# via the Admin Dashboard under "Payment Gateway Settings" (stored encrypted with AES-256-GCM in the database).
STRIPE_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
